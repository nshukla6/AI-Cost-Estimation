# API base URL — see docs/AI_Cost_Tracking_API_Design.docx (base path /api/v1)
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCK_API=false
# Auth toggles — both can be enabled at once (SSO offered first, with a
# basic-auth fallback on the login page)
VITE_SSO_ENABLED=false
VITE_BASIC_AUTH_ENABLED=true
VITE_SSO_LOGIN_URL=/api/v1/auth/saml/login
